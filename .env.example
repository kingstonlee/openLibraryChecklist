# Copy this file to .env and adjust the values for your environment.
# The .env file is git-ignored and should never be committed.

# Port the Express server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Optional shared secret that authorizes granting admin rights via the
# /api/users/:id/toggle-admin endpoint (sent as the x-admin-setup-token header).
# Leave unset if you bootstrap admins only with scripts/setup-admin.js.
# ADMIN_SETUP_TOKEN=change-me
