# Copy this file to .env and adjust the values for your environment.
# The .env file is git-ignored and should never be committed.

# Port the Express server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# Optional shared secret that authorizes granting admin rights via the
# /api/users/:id/toggle-admin endpoint (sent as the x-admin-setup-token header).
# Leave unset if you bootstrap admins only with scripts/setup-admin.js.
# ADMIN_SETUP_TOKEN=change-me

# Secret used to sign session tokens issued at login. Set a long random value
# in production so tokens survive restarts; if unset, an ephemeral secret is
# generated at boot (sessions reset on restart).
# SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated list of origins allowed to make cross-origin (CORS) requests,
# e.g. https://example.com,https://www.example.com. If unset, cross-origin
# requests are not granted CORS access (same-origin still works).
# CORS_ORIGINS=
